# RE DESIGN — 公開先が Apache 系（さくら・ロリポップ・エックスサーバーなど）のときの .htaccess のひな形 [DESIGN.md §124]
# dist/ の中身と一緒に、サイトの直下に「.htaccess」という名前で置く。
# サーバーが nginx のときは使えないので、同じ内容を管理画面かサーバーの設定で行う。

# ---- https と www なしにそろえる（canonical は https://redesign.tokyo/）----
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://redesign.tokyo%{REQUEST_URI} [R=301,L]

# ---- 旧 WordPress の URL（/?p=…、/category/… など）はトップへ ----
# 旧サイトの個別ページに外部リンクや検索結果が残っている場合の受け皿。要らなければ消す
RewriteCond %{QUERY_STRING} ^p=\d+ [NC]
RewriteRule ^$ https://redesign.tokyo/? [R=301,L]

# ---- 404 ページ ----
ErrorDocument 404 /404.html

# ---- 圧縮（Lighthouse「テキスト圧縮」）----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/plain
</IfModule>

# ---- キャッシュ（Lighthouse「キャッシュの有効期間」）----
# 画像・CSS・JS は 1 年。HTML は毎回確認。CSS と JS は ?v=印 で読んでいるので、更新しても古いものは残らない
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
